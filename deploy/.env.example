SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_URL=jdbc:postgresql://postgres:5432/x_ai_gateway?connectionTimeZone=UTC
DB_USERNAME=x_ai_gateway
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

GATEWAY_ENCRYPTION_KEY=replace-with-32-byte-or-longer-secret
GATEWAY_FILE_ROOT=/app/.data/files
GATEWAY_ROUTING_RUNTIME_STORE_TYPE=redis
GATEWAY_ROUTING_RUNTIME_STORE_FALLBACK_TO_MEMORY=false

GATEWAY_ADMIN_CONSOLE_ENABLED=true
GATEWAY_ADMIN_CONSOLE_USERNAME=admin
GATEWAY_ADMIN_CONSOLE_PASSWORD=change-me

SPRING_AI_OPENAI_API_KEY=disabled-placeholder
SPRING_AI_ANTHROPIC_API_KEY=disabled-placeholder
SPRING_AI_GOOGLE_GENAI_API_KEY=disabled-placeholder
