# ==========================================
# 1. 基础忽略与大文件
# ==========================================
.*
*.log
*.sql
*.md
# 排除大型媒体和UI设计文件
*.svg
*.png
*.jpg
*.ico
assets/
public/
test/

# ==========================================
# 2. 后端：Java + Spring + Gradle 核心排除 (重要！)
# ==========================================
# Gradle 本地缓存（体积超级大，坚决排除）
.gradle/
# Gradle 包装器目录（包含 .jar 这种二进制文件，AI不需要看）
gradle/
gradlew
gradlew.bat

# Java 构建输出目录（包含大量的 .class 文件和巨大的 fat jar）
build/
out/
bin/

# 编译后的二进制文件
*.class
*.jar
*.war

# 过滤多语言翻译文件 / Mock 数据 / 文档
locales/
i18n/
*.md
mock/
mocks/

# IDE 自动生成的配置
.idea/
*.iml
*.iws
*.ipr
.vscode/

# ==========================================
# 3. 前端：依赖与打包产物排除 (假设你有Node前端)
# ==========================================
node_modules/
dist/
# 如果你的前端打包目录也叫 build，上面后端的 build/ 规则已经一起排除了

# 锁文件千万不要发给 AI（动辄几十万行毫无意义的版本号）
package-lock.json
yarn.lock
pnpm-lock.yaml