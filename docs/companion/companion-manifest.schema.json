{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x-ai-gateway.local/schemas/companion-manifest.schema.json",
  "title": "x-ai-gateway Companion Manifest",
  "type": "object",
  "required": ["manifestVersion", "clientInstance", "capabilities", "privacy"],
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^1\\.0$" },
    "clientInstance": {
      "type": "object",
      "required": ["clientFamily", "instanceId", "workspaceHint"],
      "properties": {
        "clientFamily": { "type": "string" },
        "instanceId": { "type": "string" },
        "workspaceHint": { "type": "string" },
        "pluginName": { "type": "string" },
        "pluginVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "mcpSummary": { "type": "boolean" },
        "skillsSummary": { "type": "boolean" },
        "sessionSummary": { "type": "boolean" },
        "workspaceHint": { "type": "boolean" },
        "deepLinkAuthorization": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["uploadsWorkspaceFiles", "uploadsSecrets", "uploadsSessionContent"],
      "properties": {
        "uploadsWorkspaceFiles": { "type": "boolean", "const": false },
        "uploadsSecrets": { "type": "boolean", "const": false },
        "uploadsSessionContent": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
