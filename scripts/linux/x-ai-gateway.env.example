SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JAVA_OPTS=-Xms512m -Xmx1024m
GATEWAY_SECURITY_ENCRYPTION_KEY=replace-with-32-byte-random-secret
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/x_ai_gateway
SPRING_DATASOURCE_USERNAME=x_ai_gateway
SPRING_DATASOURCE_PASSWORD=replace-with-db-password
SPRING_LIQUIBASE_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
