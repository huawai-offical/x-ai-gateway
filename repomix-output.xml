                      {item.active ? 'active' : 'inactive'}
                    </StatusBadge>
                    <StatusBadge>{item.allowedProtocols.length ? item.allowedProtocols.join(', ') : 'all protocols'}</StatusBadge>
                  </div>
                  <div className="text-sm text-muted-foreground">
                    providers: {item.allowedProviderTypes.length ? item.allowedProviderTypes.join(', ') : 'all'}
                  </div>
                  <Button asChild variant="outline" size="sm">
                    <Link to={`/keys/${item.id}`}>
                      查看策略
                      <ArrowUpRightIcon data-icon="inline-end" />
                    </Link>
                  </Button>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : (
          <EmptyState title="还没有 DistributedKey" description="创建第一个 Key 后，就可以继续配置预算、协议权限和客户端家族约束。" />
        )}
      </PageSection>
    </div>
  )
}
