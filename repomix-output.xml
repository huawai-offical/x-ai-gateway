<file path="web/src/features/credentials/credential-detail-page.tsx">
import { type FormEvent, useState } from 'react'
import { useNavigate, useParams } from 'react-router-dom'
import { useQueryClient } from '@tanstack/react-query'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Textarea } from '@/components/ui/textarea'
import { EmptyState } from '@/components/app/empty-state'
import { InfoGrid } from '@/components/app/info-grid'
import { InlineError } from '@/components/app/inline-error'
import { PageSection } from '@/components/app/page-section'
import { PageSkeleton } from '@/components/app/page-skeleton'
import { StatusBadge } from '@/components/app/status-badge'
import { formatInstant } from '@/lib/format'
import { apiRequest } from '@/lib/api'
import { useTypedMutation, useTypedQuery } from '@/lib/typed-react-query'
import {
  AUTH_KIND_OPTIONS,
  buildCredentialPayload,
  createEmptyCredentialForm,
  credentialToFormState,
  PROVIDER_TYPE_OPTIONS,
  type CredentialConnectivityResponse,
  type CredentialFormState,
  type CredentialModelRefreshResponse,
  type CredentialResponse,
} from './types'
export function CredentialDetailPage() {
  const { id } = useParams()
  const navigate = useNavigate()
  const queryClient = useQueryClient()
  const [draftForm, setDraftForm] = useState<CredentialFormState | null>(null)
  const [formError, setFormError] = useState<string | null>(null)
  const [connectivityResult, setConnectivityResult] = useState<CredentialConnectivityResponse | null>(null)
  const [refreshResult, setRefreshResult] = useState<CredentialModelRefreshResponse | null>(null)
  const credentialQuery = useTypedQuery<CredentialResponse>({
    queryKey: ['credential', id],
    enabled: Boolean(id),
    queryFn: () => apiRequest<CredentialResponse>(`/admin/credentials/${id}`),
  })
  const updateMutation = useTypedMutation<CredentialResponse, ReturnType<typeof buildCredentialPayload>>({
    mutationFn: (payload) =>
      apiRequest<CredentialResponse>(`/admin/credentials/${id}`, {
        method: 'PUT',
        body: JSON.stringify(payload),
      }),
    onSuccess: (data) => {
      setDraftForm(credentialToFormState(data))
      setFormError(null)
      queryClient.invalidateQueries({ queryKey: ['credential', id] })
      queryClient.invalidateQueries({ queryKey: ['credentials'] })
    },
  })
  const connectivityMutation = useTypedMutation<CredentialConnectivityResponse, ReturnType<typeof buildCredentialPayload>>({
    mutationFn: (payload) =>
      apiRequest<CredentialConnectivityResponse>('/admin/credentials/test-connectivity', {
        method: 'POST',
        body: JSON.stringify(payload),
      }),
    onSuccess: (data) => {
      setConnectivityResult(data)
      setFormError(null)
    },
  })
  const toggleMutation = useTypedMutation<CredentialResponse, boolean>({
    mutationFn: (active) =>
      apiRequest<CredentialResponse>(`/admin/credentials/${id}/status?active=${active}`, {
        method: 'POST',
      }),
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ['credential', id] })
      queryClient.invalidateQueries({ queryKey: ['credentials'] })
      setDraftForm(credentialToFormState(data))
    },
  })
  const refreshMutation = useTypedMutation<CredentialModelRefreshResponse, void>({
    mutationFn: () =>
      apiRequest<CredentialModelRefreshResponse>(`/admin/credentials/${id}/refresh-models`, {
        method: 'POST',
      }),
    onSuccess: (data) => {
      setRefreshResult(data)
    },
  })
  const deleteMutation = useTypedMutation<void, void>({
    mutationFn: () =>
      apiRequest<void>(`/admin/credentials/${id}`, {
        method: 'DELETE',
      }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['credentials'] })
      navigate('/credentials')
    },
  })
  const handleSave = (event: FormEvent) => {
    event.preventDefault()
    try {
      const payload = buildCredentialPayload(form)
      setFormError(null)
      updateMutation.mutate(payload)
    } catch (error) {
      setFormError(error instanceof Error ? error.message : '无法更新凭证。')
    }
  }
  const handleConnectivityTest = () => {
    try {
      const payload = buildCredentialPayload(form)
      setFormError(null)
      connectivityMutation.mutate(payload)
    } catch (error) {
      setFormError(error instanceof Error ? error.message : '无法测试联通性。')
    }
  }
  const handleDelete = () => {
    if (!window.confirm('确认删除当前凭证吗？')) {
      return
    }
    deleteMutation.mutate(undefined)
  }
  const credential = credentialQuery.data
  const form = draftForm ?? (credential ? credentialToFormState(credential) : createEmptyCredentialForm())
  const updateForm = (updater: (current: CredentialFormState) => CredentialFormState) => {
    setDraftForm((current) => updater(current ?? form))
  }
  if (credentialQuery.isPending) {
    return <PageSkeleton count={1} />
  }
  if (credentialQuery.error) {
    return <InlineError error={credentialQuery.error} title="凭证详情加载失败" />
  }
  if (!credential) {
    return <EmptyState title="未找到凭证" description="请返回凭证列表重新选择，或确认当前凭证是否已被删除。" />
  }
  return (
    <div className="flex flex-col gap-6">
      <PageSection
        kicker="Credential Detail"
        title={credential.credentialName}
        description="这里维护上游 API key / secret 凭证。若只是调整平台访问策略，请回到 Keys；若要管理 OAuth 账号，请使用账号池。"
      >
        <InfoGrid
          items={[
            { key: 'provider', label: 'Provider', value: `${credential.providerType} / ${credential.authKind}` },
            {
              key: 'active',
              label: '状态',
              value: <StatusBadge tone={credential.active ? 'success' : 'warning'}>{credential.active ? 'active' : 'inactive'}</StatusBadge>,
            },
            { key: 'fingerprint', label: '指纹', value: credential.secretFingerprint },
            { key: 'last-used', label: 'Last Used', value: formatInstant(credential.lastUsedAt) },
            { key: 'cooldown', label: 'Cooldown', value: formatInstant(credential.cooldownUntil) },
            { key: 'last-error', label: '最近错误', value: credential.lastErrorMessage ?? '无' },
          ]}
        />
      </PageSection>
      <PageSection kicker="Bindings" title="绑定信息" description="查看当前凭证绑定到哪个 siteProfile、proxy 和 TLS 指纹配置。">
        <InfoGrid
          items={[
            { key: 'site', label: 'Site Profile ID', value: credential.siteProfileId ?? '自动绑定' },
            { key: 'proxy', label: 'Proxy ID', value: credential.proxyId ?? '无' },
            { key: 'tls', label: 'TLS 指纹 ID', value: credential.tlsFingerprintProfileId ?? '无' },
            { key: 'created', label: 'Created At', value: formatInstant(credential.createdAt) },
            { key: 'updated', label: 'Updated At', value: formatInstant(credential.updatedAt) },
          ]}
          columnsClassName="md:grid-cols-2 xl:grid-cols-5"
        />
      </PageSection>
      <PageSection kicker="Edit Credential" title="编辑凭证" description="修改基础连接信息、绑定信息和 metadata，必要时重新输入 secret。">
        <form className="flex flex-col gap-4" onSubmit={handleSave}>
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">凭证名称</span>
              <Input
                value={form.credentialName}
                onChange={(event) => updateForm((current) => ({ ...current, credentialName: event.target.value }))}
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Provider</span>
              <select
                className="flex h-10 w-full rounded-md border border-input bg-background px-3 text-sm"
                value={form.providerType}
                onChange={(event) => updateForm((current) => ({ ...current, providerType: event.target.value }))}
              >
                {PROVIDER_TYPE_OPTIONS.map((option) => (
                  <option key={option} value={option}>{option}</option>
                ))}
              </select>
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Auth Kind</span>
              <select
                className="flex h-10 w-full rounded-md border border-input bg-background px-3 text-sm"
                value={form.authKind}
                onChange={(event) => updateForm((current) => ({ ...current, authKind: event.target.value }))}
              >
                {AUTH_KIND_OPTIONS.map((option) => (
                  <option key={option} value={option}>{option}</option>
                ))}
              </select>
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Base URL</span>
              <Input
                value={form.baseUrl}
                onChange={(event) => updateForm((current) => ({ ...current, baseUrl: event.target.value }))}
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">更新用 Secret</span>
              <Input
                type="password"
                value={form.secret}
                onChange={(event) => updateForm((current) => ({ ...current, secret: event.target.value }))}
                placeholder="后端当前要求更新时重新输入 secret"
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Site Profile ID</span>
              <Input
                value={form.siteProfileId}
                onChange={(event) => updateForm((current) => ({ ...current, siteProfileId: event.target.value }))}
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Proxy ID</span>
              <Input
                value={form.proxyId}
                onChange={(event) => updateForm((current) => ({ ...current, proxyId: event.target.value }))}
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">TLS 指纹 ID</span>
              <Input
                value={form.tlsFingerprintProfileId}
                onChange={(event) => updateForm((current) => ({ ...current, tlsFingerprintProfileId: event.target.value }))}
              />
            </label>
          </div>
          <label className="flex flex-col gap-2">
            <span className="text-sm font-medium text-foreground">Metadata JSON</span>
            <Textarea
              rows={5}
              value={form.metadataJson}
              onChange={(event) => updateForm((current) => ({ ...current, metadataJson: event.target.value }))}
            />
          </label>
          <label className="flex items-center gap-3 rounded-2xl border border-border/60 bg-muted/20 px-4 py-3">
            <input
              type="checkbox"
              className="size-4 rounded border-border"
              checked={form.active}
              onChange={(event) => updateForm((current) => ({ ...current, active: event.target.checked }))}
            />
            <span className="text-sm font-medium text-foreground">保存后保持启用</span>
          </label>
          <div className="flex flex-wrap gap-2">
            <Button type="submit" disabled={updateMutation.isPending}>保存更新</Button>
            <Button type="button" variant="outline" onClick={handleConnectivityTest} disabled={connectivityMutation.isPending}>
              测试联通性
            </Button>
            <Button type="button" variant="outline" onClick={() => toggleMutation.mutate(!credential.active)} disabled={toggleMutation.isPending}>
              {credential.active ? '停用凭证' : '启用凭证'}
            </Button>
            <Button type="button" variant="outline" onClick={() => refreshMutation.mutate(undefined)} disabled={refreshMutation.isPending}>
              刷新模型
            </Button>
            <Button type="button" variant="outline" onClick={handleDelete} disabled={deleteMutation.isPending}>
              删除凭证
            </Button>
          </div>
        </form>
        {(formError || updateMutation.error || connectivityMutation.error || refreshMutation.error || deleteMutation.error) ? (
          <InlineError
            error={
              updateMutation.error
              ?? connectivityMutation.error
              ?? refreshMutation.error
              ?? deleteMutation.error
              ?? new Error(formError ?? '凭证操作失败')
            }
            title="凭证操作失败"
          />
        ) : null}
        {connectivityResult ? (
          <div className="rounded-2xl border border-emerald-200 bg-emerald-50/80 px-4 py-3 text-sm text-emerald-900">
            {connectivityResult.message} 发现 {connectivityResult.discoveredModelCount} 个模型。
          </div>
        ) : null}
        {refreshResult ? (
          <div className="rounded-2xl border border-cyan-200 bg-cyan-50/80 px-4 py-3 text-sm text-cyan-900">
            模型刷新完成：{refreshResult.modelCount} 个模型，时间 {formatInstant(refreshResult.refreshedAt)}。
          </div>
        ) : null}
      </PageSection>
    </div>
  )
}
