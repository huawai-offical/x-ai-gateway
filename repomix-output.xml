      >
        <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <MetricCard label="Error Policies" value={errorPolicyMetrics.total} hint={`${errorPolicyMetrics.rewrite} rewrite / ${errorPolicyMetrics.downgrade} downgrade`} />
          <MetricCard label="Route Guards" value={routeGuardMetrics.total} hint={`${routeGuardMetrics.overrideAllow} allow override / ${routeGuardMetrics.overrideBlock} block override`} />
          <MetricCard label="Guarded Entities" value={quarantinesQuery.data?.length ?? 0} hint="当前 active quarantine 数量" />
          <MetricCard label="Simulation" value={simulationMutation.data?.nodes.length ?? 0} hint={simulationMutation.data?.finalAction ?? '等待模拟输入'} />
        </div>
        <Tabs value={activeTab} onValueChange={handleTabChange} className="gap-4">
          <TabsList variant="line" className="w-full justify-start overflow-x-auto">
