        ) : null}
        <ListSection title="Blocked Reasons" items={resolution.blockedReasons} emptyText="当前没有 blocker reason。" />
        <ListSection title="Loss Reasons" items={resolution.lossReasons} emptyText="当前没有 loss reason。" />
        <div className="flex flex-wrap gap-2">
          <Button asChild variant="outline" size="sm">
            <Link to={`/provider-sites/${row.siteProfileId}${surfaceKey ? `?surface=${encodeURIComponent(surfaceKey)}` : ''}`}>
              查看站点档案
              <ArrowUpRightIcon data-icon="inline-end" />
            </Link>
          </Button>
          <Button asChild variant="outline" size="sm">
            <Link
              to={`/workbench?protocol=${encodeURIComponent(resolveProtocol(row.compatibilitySurface))}&requestPath=${encodeURIComponent(normalizedPath)}&requestedModel=${encodeURIComponent(row.displayName)}`}
            >
              打开 Workbench
              <ArrowUpRightIcon data-icon="inline-end" />
            </Link>
          </Button>
          <Button asChild variant="outline" size="sm">
            <Link
              to={`/traces?providerType=${encodeURIComponent(row.siteKind)}&requestPath=${encodeURIComponent(normalizedPath)}`}
            >
              查看 Trace
              <WaypointsIcon data-icon="inline-start" />
            </Link>
          </Button>
          <Button asChild variant="outline" size="sm">
            <Link to={`/incidents?entityType=SITE_PROFILE&entityRef=${encodeURIComponent(String(row.siteProfileId))}`}>
              查看 Incident
              <ArrowUpRightIcon data-icon="inline-end" />
            </Link>
          </Button>
        </div>
      </CardContent>
    </Card>
  )
}
function DetailItem({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex items-center justify-between gap-3 rounded-2xl border border-border/60 bg-background/90 px-4 py-3">
      <span className="text-xs font-medium uppercase tracking-[0.16em] text-muted-foreground">{label}</span>
      <span className="max-w-[14rem] break-all text-right text-sm text-foreground">{value}</span>
    </div>
  )
}
function ListSection({
  title,
  items,
  emptyText,
}: {
  title: string
  items: string[]
  emptyText: string
}) {
  return (
    <div className="flex flex-col gap-2">
      <div className="text-xs font-medium uppercase tracking-[0.16em] text-muted-foreground">{title}</div>
      {items.length ? (
        items.map((item) => (
          <div key={item} className="rounded-2xl border border-border/60 bg-background/90 px-4 py-3 text-sm leading-6 text-foreground">
            {item}
          </div>
        ))
      ) : (
        <div className="rounded-2xl border border-dashed border-border/60 bg-background/60 px-4 py-3 text-sm text-muted-foreground">
          {emptyText}
        </div>
      )}
    </div>
  )
}
function findPrimarySurface(row: CapabilityMatrixRow, featureKey: string) {
  return Object.entries(row.surfaces)
    .map(([surfaceKey, surface]) => ({ surfaceKey, surface }))
    .find((entry) => entry.surface.requiredFeatures.includes(featureKey))
}
function resolveCapabilityState(resolution?: CapabilityResolution): CapabilityState {
  const effectiveLevel = resolution?.effectiveLevel?.toUpperCase()
  if (!resolution || effectiveLevel === 'UNSUPPORTED' || resolution.blockedReasons.length) {
    return 'UNSUPPORTED'
  }
  if (effectiveLevel === 'LOSSY' || resolution.lossReasons.length) {
    return 'LOSSY'
  }
  if (effectiveLevel === 'EMULATED') {
    return 'EMULATED'
  }
  return 'NATIVE'
}
function stateTone(state: CapabilityState) {
  switch (state) {
    case 'NATIVE':
      return {
        base: 'border-cyan-200 bg-cyan-50 text-cyan-950',
        selected: 'border-cyan-400 bg-cyan-100 text-cyan-950 ring-2 ring-cyan-300/60',
        badge: 'success' as const,
      }
    case 'EMULATED':
      return {
        base: 'border-sky-200 bg-sky-50 text-sky-950',
        selected: 'border-sky-400 bg-sky-100 text-sky-950 ring-2 ring-sky-300/60',
        badge: 'info' as const,
      }
    case 'LOSSY':
      return {
        base: 'border-amber-200 bg-amber-50 text-amber-950',
        selected: 'border-amber-400 bg-amber-100 text-amber-950 ring-2 ring-amber-300/60',
        badge: 'warning' as const,
      }
    case 'UNSUPPORTED':
      return {
        base: 'border-rose-200 bg-rose-50 text-rose-950',
        selected: 'border-rose-400 bg-rose-100 text-rose-950 ring-2 ring-rose-300/60',
        badge: 'danger' as const,
      }
  }
}
function compactStatusLabel(status: string) {
  const normalized = status.toUpperCase()
  if (normalized === 'DEGRADED' || normalized === 'ORCHESTRATION') return 'Translated'
  if (normalized === 'BLOCKED') return 'Blocked'
  return normalized
}
function compactStatusDescription(state: CapabilityState) {
  switch (state) {
    case 'NATIVE':
      return '原生支持'
    case 'EMULATED':
      return '模拟 / 翻译'
    case 'LOSSY':
      return '有损'
    case 'UNSUPPORTED':
      return '阻断'
  }
}
function resolveProtocol(surface: string) {
  if (surface === 'google_native') return 'google_native'
  if (surface === 'anthropic_native') return 'anthropic_native'
  return 'openai'
}
