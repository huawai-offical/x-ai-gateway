import '@testing-library/jest-dom/vitest'
import { fireEvent, render, screen, waitFor } from '@testing-library/react'
import { MemoryRouter, Route, Routes } from 'react-router-dom'
import { beforeEach, describe, expect, it } from 'vitest'
import { AppLayout } from './layout'
import { AppProviders } from './providers'
function renderLayout(initialEntry = '/workbench') {
  return render(
    <AppProviders>
      <MemoryRouter initialEntries={[initialEntry]}>
        <Routes>
          <Route element={<AppLayout />}>
            <Route path="/workbench" element={<div>workbench</div>} />
            <Route path="/keys" element={<div>keys</div>} />
          </Route>
        </Routes>
      </MemoryRouter>
    </AppProviders>,
  )
}
describe('AppLayout', () => {
  beforeEach(() => {
    window.localStorage.clear()
  })
  it('renders breadcrumb title and restores persisted workspace context', async () => {
    window.localStorage.setItem(
      'x-ai-gateway:workspace-context',
      JSON.stringify({
        workspace: 'control-plane',
        environment: 'staging',
        tenantSlot: 'ops',
      }),
    )
    renderLayout()
    expect(await screen.findByRole('heading', { name: 'Translation Workbench' })).toBeInTheDocument()
    expect(screen.getAllByText('站点真相').length).toBeGreaterThan(0)
    await waitFor(() => {
      expect(screen.getAllByText('staging')[0]).toBeInTheDocument()
      expect(screen.getAllByText('ops')[0]).toBeInTheDocument()
      expect(screen.getAllByText('control-plane')[0]).toBeInTheDocument()
    })
  })
  it('persists collapsed sidebar state after toggling the desktop rail', async () => {
    renderLayout('/keys')
    expect(screen.getAllByText('Issue: X-218').length).toBeGreaterThan(0)
    fireEvent.click(screen.getAllByRole('button', { name: '切换侧边栏' })[0])
    await waitFor(() => {
      expect(window.localStorage.getItem('x-ai-gateway:sidebar-collapsed')).toBe('true')
      expect(screen.queryAllByText('Issue: X-218')).toHaveLength(1)
    })
  })
})
