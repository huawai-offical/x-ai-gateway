                  meta={[
                    `${delivery.deliveryStatus} / attempt ${delivery.attemptCount}`,
                    `${delivery.entityType ?? 'SYSTEM'} / ${delivery.entityRef ?? '-'}`,
                  ]}
                  footer={
                    <div className="flex flex-wrap gap-2">
                      {delivery.requestId ? (
                        <ActionButton
                          to={`/traces?requestId=${encodeURIComponent(delivery.requestId)}`}
                          label="查看 Trace"
                        />
                      ) : null}
                      <ActionButton to="/integrations/deliveries" label="查看全部投递" />
                    </div>
                  }
                />
              ))}
