<file path="web/src/features/accounts/account-detail-page.tsx">
import { type FormEvent, useEffect, useMemo, useState } from 'react'
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
import { useParams } from 'react-router-dom'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { CodePanel } from '@/components/app/code-panel'
import { EmptyState } from '@/components/app/empty-state'
import { InfoGrid } from '@/components/app/info-grid'
import { InlineError } from '@/components/app/inline-error'
import { PageSection } from '@/components/app/page-section'
import { PageSkeleton } from '@/components/app/page-skeleton'
import { StatusBadge } from '@/components/app/status-badge'
import { apiRequest } from '@/lib/api'
type Account = {
  id: number
  accountName: string
  providerType: string
  externalAccountId: string
  healthy: boolean
  frozen: boolean
  proxyId?: number | null
  tlsFingerprintProfileId?: number | null
}
export function AccountDetailPage() {
  const { id } = useParams()
  const queryClient = useQueryClient()
  const accountQuery = useQuery({
    queryKey: ['account', id],
    queryFn: () => apiRequest<Account>(`/admin/accounts/${id}`),
    enabled: Boolean(id),
  })
  const [proxyId, setProxyId] = useState('')
  const [tlsFingerprintProfileId, setTlsFingerprintProfileId] = useState('')
  useEffect(() => {
    if (!accountQuery.data) {
      return
    }
    setProxyId(accountQuery.data.proxyId == null ? '' : String(accountQuery.data.proxyId))
    setTlsFingerprintProfileId(
      accountQuery.data.tlsFingerprintProfileId == null ? '' : String(accountQuery.data.tlsFingerprintProfileId),
    )
  }, [accountQuery.data])
  const refreshMutation = useMutation({
    mutationFn: () => apiRequest(`/admin/accounts/${id}/refresh`, { method: 'POST' }),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['account', id] }),
  })
  const freezeMutation = useMutation({
    mutationFn: (frozen: boolean) => apiRequest(`/admin/accounts/${id}/freeze?frozen=${frozen}`, { method: 'POST' }),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['account', id] }),
  })
  const networkMutation = useMutation({
    mutationFn: () =>
      apiRequest(`/admin/accounts/${id}/network`, {
        method: 'POST',
        body: JSON.stringify({
          proxyId: proxyId.trim() ? Number(proxyId) : null,
          tlsFingerprintProfileId: tlsFingerprintProfileId.trim() ? Number(tlsFingerprintProfileId) : null,
        }),
      }),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['account', id] }),
  })
  const exportMutation = useMutation({
    mutationFn: () => apiRequest<{ config: string }>(`/admin/accounts/${id}/export?clientFamily=GENERIC_OPENAI`),
  })
  const handleNetworkSave = (event: FormEvent) => {
    event.preventDefault()
    networkMutation.mutate()
  }
  const account = accountQuery.data
  const accountItems = useMemo(
    () =>
      account
        ? [
            { key: 'provider', label: 'Provider', value: account.providerType },
            { key: 'external', label: 'External Account', value: account.externalAccountId },
            {
              key: 'healthy',
              label: 'Healthy',
              value: <StatusBadge tone={account.healthy ? 'success' : 'danger'}>{String(account.healthy)}</StatusBadge>,
            },
            {
              key: 'frozen',
              label: 'Frozen',
              value: <StatusBadge tone={account.frozen ? 'warning' : 'info'}>{String(account.frozen)}</StatusBadge>,
            },
            { key: 'proxy', label: 'Proxy ID', value: account.proxyId ?? '未绑定' },
            { key: 'tls', label: 'TLS Profile ID', value: account.tlsFingerprintProfileId ?? '未绑定' },
          ]
        : [],
    [account],
  )
  return (
    <div className="flex flex-col gap-6">
      <PageSection
        kicker="Account"
        title={account?.accountName ?? '账号详情'}
        description="查看上游账号当前授权状态、网络绑定和可导出的配置。"
        actions={
          <div className="flex flex-wrap gap-2">
            <Button variant="outline" onClick={() => refreshMutation.mutate()} disabled={refreshMutation.isPending || !account}>
              刷新
            </Button>
            <Button
              variant="outline"
              onClick={() => freezeMutation.mutate(!(account?.frozen ?? false))}
              disabled={freezeMutation.isPending || !account}
            >
              {account?.frozen ? '解冻' : '冻结'}
            </Button>
            <Button onClick={() => exportMutation.mutate()} disabled={exportMutation.isPending || !account}>
              导出配置
            </Button>
          </div>
        }
      >
        {accountQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : accountQuery.error ? (
          <InlineError error={accountQuery.error} title="账号详情加载失败" />
        ) : account ? (
          <div className="flex flex-col gap-6">
            <InfoGrid items={accountItems} columnsClassName="md:grid-cols-2 xl:grid-cols-3" />
            {(refreshMutation.error || freezeMutation.error || networkMutation.error || exportMutation.error) ? (
              <InlineError
                error={refreshMutation.error ?? freezeMutation.error ?? networkMutation.error ?? exportMutation.error}
                title="账号操作失败"
              />
            ) : null}
            <form className="grid gap-4 rounded-2xl border border-border/60 bg-muted/20 p-4 md:grid-cols-2" onSubmit={handleNetworkSave}>
              <label className="flex flex-col gap-2">
                <span className="text-sm font-medium text-foreground">Proxy ID</span>
                <Input value={proxyId} onChange={(event) => setProxyId(event.target.value)} placeholder="proxy id" />
              </label>
              <label className="flex flex-col gap-2">
                <span className="text-sm font-medium text-foreground">TLS Profile ID</span>
                <Input
                  value={tlsFingerprintProfileId}
                  onChange={(event) => setTlsFingerprintProfileId(event.target.value)}
                  placeholder="tls profile id"
                />
              </label>
              <div className="md:col-span-2">
                <Button type="submit" disabled={networkMutation.isPending}>
                  保存网络绑定
                </Button>
              </div>
            </form>
          </div>
        ) : (
          <EmptyState title="未找到账号" description="请确认当前账号是否仍然存在，或返回账号池重新发起授权。" />
        )}
      </PageSection>
      {exportMutation.data ? (
        <CodePanel
          title="导出配置"
          description="导出的配置可用于对接 Generic OpenAI 客户端。"
          code={exportMutation.data.config}
        />
      ) : null}
    </div>
  )
}
</file>

