      </PageSection>
      <PageSection kicker="Key Inventory" title="策略对象列表" description="每个 Key 都承载独立的协议权限、预算限制和绑定策略。">
        {keysQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : keysQuery.error ? (
          <InlineError error={keysQuery.error} title="Key 列表加载失败" />
        ) : keysQuery.data?.length ? (
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
