  switch (tab) {
    case 'entity':
      return 'Entities'
    case 'actions':
      return 'Actions'
    case 'raw':
      return 'Raw JSON'
  }
}
function resolveSecondaryTab(value: string | null): SecondaryTab {
  if (value && SECONDARY_TABS.includes(value as SecondaryTab)) {
    return value as SecondaryTab
  }
