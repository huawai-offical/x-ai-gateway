        <StatusBadge tone={connectionTone(connectionState)}>
          {connectionLabel(connectionState)}
        </StatusBadge>
        <StatusBadge tone="info">Traffic Snapshot + Alert Events</StatusBadge>
      </div>
      <OpsRealtimeEventList
        events={events.slice(0, limit)}
        title={title}
        description={description}
        emptyTitle="当前还没有实时事件"
      />
    </div>
  )
}
function OpsRealtimeEventList({
  events,
  title,
  description,
  emptyTitle,
}: {
  events: OpsRealtimeFeedItem[]
  title?: string
  description?: string
  emptyTitle: string
}) {
  if (!events.length) {
    return (
      <EmptyState
        title={emptyTitle}
        description="WebSocket 连接建立后，这里会自动滚动显示最新网关事件。"
        icon={<RadioTowerIcon className="size-5" />}
      />
    )
  }
  return (
    <div className="flex flex-col gap-3">
      {title ? (
        <div className="space-y-1">
          <div className="text-sm font-medium text-foreground">{title}</div>
          {description ? <div className="text-sm text-muted-foreground">{description}</div> : null}
        </div>
      ) : null}
      <div className="flex flex-col gap-3">
        {events.map((item) => (
          <div
            key={item.id}
            className="rounded-2xl border border-border/60 bg-background/90 px-4 py-3 shadow-sm"
          >
            <div className="flex items-start justify-between gap-3">
              <div className="min-w-0 space-y-1">
                <div className="flex items-center gap-2">
                  <span className="truncate text-sm font-medium text-foreground">{item.title}</span>
                  <StatusBadge tone={item.tone}>{eventLabel(item.type)}</StatusBadge>
                </div>
                <div className="text-sm leading-6 text-muted-foreground">{item.summary}</div>
              </div>
              <div className="shrink-0 text-xs text-muted-foreground">{formatInstant(item.emittedAt)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}
export function parseRealtimeEvent(raw: string): OpsRealtimeFeedItem | null {
  let envelope: OpsRealtimeEnvelope
  try {
    envelope = JSON.parse(raw) as OpsRealtimeEnvelope
  } catch {
    return {
      id: `raw:${raw}`,
      type: 'unknown',
      emittedAt: new Date().toISOString(),
      title: 'Unknown event',
      summary: raw,
      tone: 'neutral',
      payload: raw,
    }
  }
  const emittedAt = envelope.emittedAt ?? new Date().toISOString()
  const payload = envelope.payload
  if (envelope.type === 'traffic_snapshot' && isTrafficSnapshot(payload)) {
    return {
      id: `traffic_snapshot:${emittedAt}`,
      type: envelope.type,
      emittedAt,
      title: 'Traffic Snapshot',
      summary: `${payload.qps.toFixed(2)} QPS · 错误率 ${(payload.errorRate * 100).toFixed(1)}% · P95 ${payload.p95LatencyMs.toFixed(0)} ms · Alerts ${payload.activeAlerts}`,
      tone: payload.activeAlerts > 0 || payload.errorRate >= 0.1 ? 'warning' : 'success',
      payload,
    }
  }
  if (envelope.type === 'alert_event' && isAlertEvent(payload)) {
    return {
      id: `alert_event:${payload.id ?? emittedAt}:${payload.status}`,
      type: envelope.type,
      emittedAt,
      title: payload.title,
      summary: `${payload.severity} · ${payload.status} · ${payload.entityType ?? 'SYSTEM'} / ${payload.entityRef ?? '-'} · ${payload.message}`,
      tone: payload.severity === 'HIGH' && payload.status === 'OPEN' ? 'danger' : 'warning',
      payload,
    }
  }
  return {
    id: `${envelope.type}:${emittedAt}`,
    type: envelope.type,
    emittedAt,
    title: envelope.type,
    summary: '收到一条网关事件。',
    tone: 'info',
    payload,
  }
}
function isTrafficSnapshot(payload: unknown): payload is OpsTrafficSnapshot {
  return typeof payload === 'object' && payload !== null && 'qps' in payload && 'errorRate' in payload
}
function isAlertEvent(payload: unknown): payload is AlertEvent {
  return typeof payload === 'object' && payload !== null && 'title' in payload && 'message' in payload
}
function connectionTone(state: OpsRealtimeContextValue['connectionState']) {
  switch (state) {
    case 'connected':
      return 'success'
    case 'connecting':
      return 'info'
    case 'disconnected':
      return 'warning'
    default:
      return 'info'
  }
}
function connectionLabel(state: OpsRealtimeContextValue['connectionState']) {
  switch (state) {
    case 'connected':
      return '已连接'
    case 'connecting':
      return '连接中'
    case 'disconnected':
      return '重连中'
    default:
      return '待连接'
  }
}
function eventLabel(type: string) {
  switch (type) {
    case 'traffic_snapshot':
      return 'Traffic'
    case 'alert_event':
      return 'Alert'
    default:
      return 'Event'
  }
}
