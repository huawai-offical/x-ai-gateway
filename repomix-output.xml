            <Input value={keyName} onChange={(event) => setKeyName(event.target.value)} placeholder="新 key 名称" />
          </label>
          <div className="flex items-end">
            <Button type="submit" disabled={createMutation.isPending || !keyName.trim()}>
              创建
            </Button>
          </div>
        </form>
