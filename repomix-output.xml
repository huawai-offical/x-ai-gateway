                      <CardDescription>{item.entityType ?? 'SYSTEM'} / {item.entityRef ?? '-'}</CardDescription>
                    </div>
                    <div className="flex flex-wrap gap-2">
                      <StatusBadge tone={item.deliveryStatus === 'SUCCEEDED' ? 'success' : 'warning'}>
                        {item.deliveryStatus}
                      </StatusBadge>
                      <StatusBadge>attempt {item.attemptCount}</StatusBadge>
                    </div>
                  </div>
                </CardHeader>
                <CardContent className="flex flex-col gap-4 p-5">
                  <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4 text-sm text-muted-foreground">
                    <div className="text-foreground">响应摘要：{item.responseSummary ?? item.lastError ?? '等待投递结果'}</div>
                    <div className="text-foreground">发生时间：{formatInstant(item.occurredAt)}</div>
                    <div className="text-foreground">下次重试：{formatInstant(item.nextRetryAt)}</div>
                    <div className="text-foreground">responseCode：{item.responseCode ?? '-'}</div>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {item.requestId ? (
                      <Button asChild variant="outline" size="sm">
                        <Link to={`/traces?requestId=${encodeURIComponent(item.requestId)}`}>
                          查看 Trace
                          <ArrowUpRightIcon data-icon="inline-end" />
                        </Link>
                      </Button>
                    ) : null}
                    {item.deliveryStatus !== 'SUCCEEDED' ? (
                      <Button type="button" variant="outline" size="sm" onClick={() => replayMutation.mutate(item.id)}>
                        重放
                      </Button>
                    ) : null}
                  </div>
                  <CodePanel title="Payload" code={item.payloadJson} className="overflow-hidden" />
                </CardContent>
              </Card>
            ))}
          </div>
        ) : (
          <EmptyState title="当前没有投递记录" description="发送一次测试投递，或等待真实事件触发后再回来查看这里的审计链路。" />
        )}
      </PageSection>
    </div>
  )
}
