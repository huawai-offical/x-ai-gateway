                Map.entry(InteropFeature.ANTHROPIC_MESSAGE_BATCH.wireName(), CapabilityResolutionView.from(siteCapabilityTruthService.resolve(entity, snapshot, InteropFeature.ANTHROPIC_MESSAGE_BATCH))),
