        return totalTokens > 0
                || rawPromptTokens > 0
                || promptTokens > 0
                || completionTokens > 0
                || reasoningTokens > 0
                || cacheHitTokens > 0
                || cacheWriteTokens > 0
                || upstreamCacheHitTokens > 0
                || upstreamCacheWriteTokens > 0
                || savedInputTokens > 0
                || (cachedContentRef != null && !cachedContentRef.isBlank())
                || nativeUsagePayload != null;
    }
