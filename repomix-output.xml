<file path="web/src/components/app/workspace-context.tsx">
import {
  createContext,
  useContext,
  useEffect,
  useMemo,
  useState,
  type PropsWithChildren,
} from 'react'
type WorkspaceOption = {
  value: string
  label: string
}
type WorkspaceContextValue = {
  workspace: string
  environment: string
  tenantSlot: string
  setWorkspace: (value: string) => void
  setEnvironment: (value: string) => void
  setTenantSlot: (value: string) => void
  workspaceOptions: WorkspaceOption[]
  environmentOptions: WorkspaceOption[]
  tenantSlotOptions: WorkspaceOption[]
}
const STORAGE_KEY = 'x-ai-gateway:workspace-context'
const workspaceOptions: WorkspaceOption[] = [
  { value: 'x-ai-gateway', label: 'x-ai-gateway' },
  { value: 'control-plane', label: 'Control Plane' },
]
const environmentOptions: WorkspaceOption[] = [
  { value: 'local', label: 'Local' },
  { value: 'staging', label: 'Staging' },
  { value: 'preview', label: 'Preview' },
]
const tenantSlotOptions: WorkspaceOption[] = [
  { value: 'platform', label: 'Platform' },
  { value: 'ops', label: 'Ops' },
  { value: 'shared', label: 'Shared' },
]
const WorkspaceContext = createContext<WorkspaceContextValue | null>(null)
export function WorkspaceContextProvider({ children }: PropsWithChildren) {
  const [workspace, setWorkspace] = useState(workspaceOptions[0].value)
  const [environment, setEnvironment] = useState(environmentOptions[0].value)
  const [tenantSlot, setTenantSlot] = useState(tenantSlotOptions[0].value)
  useEffect(() => {
    const raw = window.localStorage.getItem(STORAGE_KEY)
    if (!raw) return
    try {
      const parsed = JSON.parse(raw) as Partial<{
        workspace: string
        environment: string
        tenantSlot: string
      }>
      if (parsed.workspace) setWorkspace(parsed.workspace)
      if (parsed.environment) setEnvironment(parsed.environment)
      if (parsed.tenantSlot) setTenantSlot(parsed.tenantSlot)
    } catch {
      window.localStorage.removeItem(STORAGE_KEY)
    }
  }, [])
  useEffect(() => {
    window.localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify({ workspace, environment, tenantSlot }),
    )
  }, [workspace, environment, tenantSlot])
  const value = useMemo<WorkspaceContextValue>(
    () => ({
      workspace,
      environment,
      tenantSlot,
      setWorkspace,
      setEnvironment,
      setTenantSlot,
      workspaceOptions,
      environmentOptions,
      tenantSlotOptions,
    }),
    [environment, tenantSlot, workspace],
  )
  return <WorkspaceContext.Provider value={value}>{children}</WorkspaceContext.Provider>
}
export function useWorkspaceContext() {
  const context = useContext(WorkspaceContext)
  if (!context) {
    throw new Error('useWorkspaceContext must be used within WorkspaceContextProvider.')
  }
  return context
}
</file>

