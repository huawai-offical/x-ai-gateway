        `resource / operation: ${requestLog?.resourceType ?? '-'} / ${requestLog?.operation ?? '-'}`,
        `support / degradation: ${requestLog?.supportStatus ?? '-'} / ${requestLog?.degradationLevel ?? '-'}`,
      ],
    },
    {
      id: 'route-selection',
      title: '路由选择',
      summary: routeDecision?.selectionSource ?? '未命中 route decision',
      detail: routeDecision?.selectedProviderType ?? (providerType || '等待选路'),
      tone: routeDecision?.supportStatus === 'BLOCKED' ? 'danger' : routeDecision ? 'success' : 'neutral',
      timestamp: routeDecision?.createdAt,
      items: [
        `selected base URL: ${routeDecision?.selectedBaseUrl ?? '-'}`,
        `candidate count: ${routeDecision?.candidateCount ?? 0}`,
        `execution backend: ${routeDecision?.executionBackend ?? '-'}`,
      ],
    },
    {
      id: 'cache-lookup',
      title: '缓存检索',
      summary: `${cacheHits.length} cache hits / ${upstreamCacheReferences.length} upstream refs`,
      detail: cacheHits.length ? '命中缓存' : 'cache miss',
      tone: cacheHits.length ? 'success' : 'info',
      timestamp: cacheHits[0]?.createdAt ?? upstreamCacheReferences[0]?.updatedAt,
      items: buildCacheItems(cacheHits, upstreamCacheReferences),
    },
    {
      id: 'translation',
      title: 'API 翻译',
      summary: `${requestLog?.objectMode ?? routeDecision?.objectMode ?? '-'} -> ${requestLog?.responseKind ?? '-'}`,
      detail: requestLog?.supportStatus ?? routeDecision?.supportStatus ?? '等待翻译结果',
      tone:
        requestLog?.supportStatus === 'BLOCKED'
          ? 'danger'
          : requestLog?.degradationLevel && requestLog.degradationLevel !== 'NATIVE'
            ? 'warning'
            : 'info',
      timestamp: requestLog?.createdAt,
      items: [
        `selection source: ${requestLog?.selectionSource ?? routeDecision?.selectionSource ?? '-'}`,
        `execution backend: ${requestLog?.executionBackend ?? routeDecision?.executionBackend ?? '-'}`,
        `response object: ${requestLog?.responseObjectType ?? '-'} / ${requestLog?.responseObjectId ?? '-'}`,
      ],
    },
    {
      id: 'remote-call',
      title: '远端调用',
      summary: `${routeDecision?.selectedProviderType ?? requestLog?.providerType ?? (providerType || 'unknown provider')}`,
      detail: requestLog?.durationMs != null ? `${requestLog.durationMs} ms` : '等待 duration',
      tone: requestLog?.status === 'FAILED' ? 'danger' : 'success',
      timestamp: requestLog?.completedAt ?? requestLog?.createdAt,
      items: [
        `credentialId: ${routeDecision?.selectedCredentialId ?? requestLog?.credentialId ?? '-'}`,
        `resolved model: ${requestLog?.resolvedModelKey ?? routeDecision?.resolvedModelKey ?? '-'}`,
        `error: ${requestLog?.errorCode ?? '无'}`,
      ],
    },
    {
      id: 'response-processing',
      title: '流式返回处理',
      summary: requestLog?.responseStatus ?? asyncResource?.status ?? '等待返回状态',
      detail: asyncResource?.normalizedStatus ?? requestLog?.responseKind ?? 'response',
      tone:
        requestLog?.status === 'FAILED'
          ? 'danger'
          : asyncResource?.status === 'FAILED'
            ? 'danger'
            : 'success',
      timestamp: asyncResource?.updatedAt ?? requestLog?.completedAt,
      items: [
        `canonical events: ${requestLog?.canonicalEventCount ?? '-'}`,
        `async resource: ${asyncResource?.resourceKey ?? '-'}`,
        `upstream object: ${asyncResource?.upstreamObjectId ?? requestLog?.responseObjectId ?? '-'}`,
      ],
    },
  ]
}
function buildCacheItems(
  cacheHits: CacheHitEntry[],
  upstreamReferences: UpstreamCacheReferenceEntry[],
) {
  const items = cacheHits.slice(0, 2).map((item) =>
    `${item.cacheKind ?? 'cache'} · saved ${item.savedInputTokens ?? 0} · ref ${item.cachedContentRef ?? '-'}`,
  )
  if (upstreamReferences[0]) {
    items.push(`upstream ref: ${upstreamReferences[0].externalCacheRef ?? '-'} · status ${upstreamReferences[0].status ?? '-'}`)
