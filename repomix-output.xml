            List<String> lossReasons,
            List<String> blockedReasons,
            AuthStrategy authStrategy,
            PathStrategy pathStrategy,
            ErrorSchemaStrategy errorSchemaStrategy,
            TranslationExecutionRequestMapping requestMapping,
