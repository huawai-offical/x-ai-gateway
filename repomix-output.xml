import {
  createContext,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
  type PropsWithChildren,
} from 'react'
import { Link } from 'react-router-dom'
import {
  ChevronDownIcon,
  ChevronUpIcon,
  RadioTowerIcon,
} from 'lucide-react'
import { toast } from 'sonner'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { EmptyState } from '@/components/app/empty-state'
import { StatusBadge } from '@/components/app/status-badge'
import { formatInstant } from '@/lib/format'
import type {
  AlertEvent,
  OpsRealtimeEnvelope,
  OpsRealtimeFeedItem,
  OpsTrafficSnapshot,
} from './types'
type OpsRealtimeContextValue = {
  connectionState: 'idle' | 'connecting' | 'connected' | 'disconnected'
  events: OpsRealtimeFeedItem[]
}
const DEFAULT_CONTEXT: OpsRealtimeContextValue = {
  connectionState: 'idle',
  events: [],
}
const OpsRealtimeContext = createContext<OpsRealtimeContextValue>(DEFAULT_CONTEXT)
export function OpsRealtimeProvider({ children }: PropsWithChildren) {
  const [connectionState, setConnectionState] = useState<OpsRealtimeContextValue['connectionState']>('idle')
  const [events, setEvents] = useState<OpsRealtimeFeedItem[]>([])
  const lastToastKeyRef = useRef<string | null>(null)
  useEffect(() => {
    if (typeof window === 'undefined' || typeof WebSocket === 'undefined' || import.meta.env.MODE === 'test') {
      return undefined
    }
    let disposed = false
    let socket: WebSocket | null = null
    let reconnectTimer: number | undefined
    const connect = () => {
      if (disposed) return
      setConnectionState('connecting')
      const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws'
      socket = new WebSocket(`${protocol}://${window.location.host}/admin/ops/ws`)
      socket.onopen = () => {
        setConnectionState('connected')
      }
      socket.onmessage = (event) => {
        const nextEvent = parseRealtimeEvent(String(event.data))
        if (!nextEvent) return
        setEvents((current) => [nextEvent, ...current].slice(0, 24))
        if (nextEvent.type === 'alert_event' && lastToastKeyRef.current !== nextEvent.id) {
          lastToastKeyRef.current = nextEvent.id
          if (nextEvent.tone === 'danger') {
            toast.error(nextEvent.title, { description: nextEvent.summary })
          } else {
            toast(nextEvent.title, { description: nextEvent.summary })
          }
        }
      }
      socket.onerror = () => {
        setConnectionState('disconnected')
      }
      socket.onclose = () => {
        if (disposed) {
          setConnectionState('idle')
          return
        }
        setConnectionState('disconnected')
        reconnectTimer = window.setTimeout(connect, 3_000)
      }
    }
    connect()
    return () => {
      disposed = true
      if (reconnectTimer != null) {
        window.clearTimeout(reconnectTimer)
      }
      socket?.close()
    }
  }, [])
  const value = useMemo(
    () => ({
      connectionState,
      events,
    }),
    [connectionState, events],
  )
  return (
    <OpsRealtimeContext.Provider value={value}>
      {children}
    </OpsRealtimeContext.Provider>
  )
}
export function useOpsRealtime() {
  return useContext(OpsRealtimeContext)
}
