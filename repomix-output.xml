import { useMemo } from 'react'
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
import { useParams } from 'react-router-dom'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card'
import { EmptyState } from '@/components/app/empty-state'
import { InfoGrid } from '@/components/app/info-grid'
import { InlineError } from '@/components/app/inline-error'
import { PageSection } from '@/components/app/page-section'
import { PageSkeleton } from '@/components/app/page-skeleton'
import { StatusBadge } from '@/components/app/status-badge'
import { apiRequest } from '@/lib/api'
type ProxyItem = { id: number; proxyName: string; proxyUrl: string; lastStatus?: string | null; lastLatencyMs?: number | null }
type ProbeResult = { id: number; status: string; latencyMs?: number | null; targetHost: string }
export function ProxyDetailPage() {
  const { id } = useParams()
  const queryClient = useQueryClient()
  const proxiesQuery = useQuery({
    queryKey: ['network-proxies'],
    queryFn: () => apiRequest<ProxyItem[]>('/admin/network/proxies'),
  })
  const current = useMemo(
    () => proxiesQuery.data?.find((item: ProxyItem) => String(item.id) === id),
    [id, proxiesQuery.data],
  )
  const probeMutation = useMutation({
    mutationFn: () => apiRequest(`/admin/network/proxies/${id}/probe`, { method: 'POST' }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['network-proxies'] })
      queryClient.invalidateQueries({ queryKey: ['network-probe-results', id] })
    },
  })
  const probeResultsQuery = useQuery({
    queryKey: ['network-probe-results', id],
    queryFn: () => apiRequest<ProbeResult[]>(`/admin/network/probes/${id}`),
    enabled: Boolean(id),
  })
  return (
    <div className="flex flex-col gap-6">
      <PageSection
        kicker="Proxy Detail"
        title={current?.proxyName ?? '代理详情'}
        description="查看代理基础信息、最近状态和拨测历史。"
        actions={
          <Button onClick={() => probeMutation.mutate()} disabled={probeMutation.isPending || !current}>
            手动 Probe
          </Button>
        }
      >
        {proxiesQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : proxiesQuery.error ? (
          <InlineError error={proxiesQuery.error} title="代理详情加载失败" />
        ) : current ? (
          <div className="flex flex-col gap-6">
            <InfoGrid
              items={[
                { key: 'url', label: 'Proxy URL', value: current.proxyUrl },
                {
                  key: 'status',
                  label: 'Last Status',
                  value: (
                    <StatusBadge tone={current.lastStatus === 'SUCCEEDED' ? 'success' : 'warning'}>
                      {current.lastStatus ?? 'unknown'}
                    </StatusBadge>
                  ),
                },
                { key: 'latency', label: 'Last Latency', value: current.lastLatencyMs == null ? '无数据' : `${current.lastLatencyMs} ms` },
              ]}
              columnsClassName="md:grid-cols-3"
            />
            {probeMutation.error ? <InlineError error={probeMutation.error} title="手动 Probe 失败" /> : null}
          </div>
        ) : (
          <EmptyState title="未找到代理节点" description="请返回代理列表重新选择，或确认当前代理是否已被删除。" />
        )}
      </PageSection>
      <PageSection kicker="Probe History" title="拨测结果" description="查看最近的目标主机、延迟和状态结果。">
        {probeResultsQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : probeResultsQuery.error ? (
          <InlineError error={probeResultsQuery.error} title="拨测结果加载失败" />
        ) : probeResultsQuery.data?.length ? (
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {probeResultsQuery.data.map((item: ProbeResult) => (
              <Card key={item.id} className="border-border/60 bg-card/92 shadow-sm">
                <CardHeader className="gap-2 border-b border-border/60">
                  <CardTitle className="text-base">{item.targetHost}</CardTitle>
                  <CardDescription>Probe #{item.id}</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-3 p-5">
                  <StatusBadge tone={item.status === 'SUCCEEDED' ? 'success' : 'warning'}>{item.status}</StatusBadge>
                  <div className="text-sm text-muted-foreground">
                    latency: {item.latencyMs == null ? '无数据' : `${item.latencyMs} ms`}
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : (
          <EmptyState title="还没有拨测结果" description="点击上方“手动 Probe”后，结果会汇总到这里。" />
        )}
      </PageSection>
    </div>
  )
}
