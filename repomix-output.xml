        {rollbackMutation.error ? <InlineError error={rollbackMutation.error} title="执行回滚失败" /> : null}
      </PageSection>
      <PageSection kicker="Rollback Jobs" title="回滚记录" description="查看最近回滚任务状态和附带说明。">
