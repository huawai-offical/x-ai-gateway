import { Fragment, useEffect, useMemo, useState, type PropsWithChildren } from 'react'
import { Link, NavLink } from 'react-router-dom'
import {
  PanelLeftCloseIcon,
  PanelLeftOpenIcon,
  SparklesIcon,
  MenuIcon,
} from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb'
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
} from '@/components/ui/sheet'
import { cn } from '@/lib/utils'
import { navigationGroups, type ResolvedRouteMeta } from '@/app/navigation'
import { ContextSwitcher } from './context-switcher'
import { GlobalActivityBar } from './global-activity-bar'
import { StatusBadge } from './status-badge'
import { useWorkspaceContext } from './workspace-context'
import { OpsRealtimeRail } from '@/features/ops/realtime'
const SIDEBAR_STORAGE_KEY = 'x-ai-gateway:sidebar-collapsed'
type AppShellProps = PropsWithChildren<{
  route: ResolvedRouteMeta
}>
export function AppShell({ route, children }: AppShellProps) {
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false)
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false)
  const { environment, tenantSlot } = useWorkspaceContext()
  useEffect(() => {
    const stored = window.localStorage.getItem(SIDEBAR_STORAGE_KEY)
    if (stored === 'true') {
      setSidebarCollapsed(true)
    }
  }, [])
  useEffect(() => {
    window.localStorage.setItem(SIDEBAR_STORAGE_KEY, String(sidebarCollapsed))
  }, [sidebarCollapsed])
  const sidebar = useMemo(
    () => (
      <SidebarContent
        collapsed={sidebarCollapsed}
        currentNav={route.navTo}
        onNavigate={() => setMobileSidebarOpen(false)}
      />
    ),
    [route.navTo, sidebarCollapsed],
  )
  return (
    <div className="min-h-svh bg-[radial-gradient(circle_at_top_left,_rgba(8,145,178,0.14),_transparent_28%),radial-gradient(circle_at_bottom_right,_rgba(59,130,246,0.14),_transparent_28%),linear-gradient(180deg,_rgba(248,250,252,0.98),_rgba(241,245,249,1))]">
      <div className="flex min-h-svh">
        <aside
          className={cn(
            'hidden border-r border-border/70 bg-sidebar/96 shadow-sm backdrop-blur md:flex md:flex-col',
            sidebarCollapsed ? 'md:w-[5.5rem]' : 'md:w-[18rem]',
          )}
        >
          {sidebar}
        </aside>
        <Sheet open={mobileSidebarOpen} onOpenChange={setMobileSidebarOpen}>
          <SheetContent side="left" className="w-[18rem] border-r border-border/70 bg-sidebar/96 p-0">
            <SheetHeader className="sr-only">
              <SheetTitle>导航菜单</SheetTitle>
              <SheetDescription>切换控制台功能区域。</SheetDescription>
            </SheetHeader>
            <div className="h-full">{sidebar}</div>
          </SheetContent>
        </Sheet>
        <div className="flex min-h-svh min-w-0 flex-1 flex-col">
          <header className="sticky top-0 z-40 border-b border-border/70 bg-background/88 backdrop-blur-xl">
            <div className="relative">
              <GlobalActivityBar />
              <div className="mx-auto flex max-w-[92rem] flex-col gap-4 px-4 py-4 lg:px-6">
                <div className="flex items-start justify-between gap-3">
                  <div className="flex min-w-0 flex-1 items-start gap-3">
                    <Button
                      variant="outline"
                      size="icon-sm"
                      className="md:hidden"
                      onClick={() => setMobileSidebarOpen(true)}
                    >
                      <MenuIcon />
                      <span className="sr-only">打开导航</span>
                    </Button>
                    <Button
                      variant="outline"
                      size="icon-sm"
                      className="hidden md:inline-flex"
                      onClick={() => setSidebarCollapsed((value) => !value)}
                    >
                      {sidebarCollapsed ? <PanelLeftOpenIcon /> : <PanelLeftCloseIcon />}
                      <span className="sr-only">切换侧边栏</span>
                    </Button>
                    <div className="min-w-0 space-y-2">
                      <Breadcrumb>
                        <BreadcrumbList>
                          {route.breadcrumbs.map((item, index) => (
                            <Fragment key={`${item.label}-${index}`}>
                              <BreadcrumbItem>
                                {item.to ? (
                                  <BreadcrumbLink asChild>
                                    <Link to={item.to}>{item.label}</Link>
                                  </BreadcrumbLink>
                                ) : index === route.breadcrumbs.length - 1 ? (
                                  <BreadcrumbPage>{item.label}</BreadcrumbPage>
                                ) : (
                                  <span>{item.label}</span>
                                )}
                              </BreadcrumbItem>
                              {index < route.breadcrumbs.length - 1 ? <BreadcrumbSeparator /> : null}
                            </Fragment>
                          ))}
                        </BreadcrumbList>
                      </Breadcrumb>
                      <div className="space-y-2">
                        <div className="flex flex-wrap items-center gap-2">
                          <h1 className="text-2xl font-semibold tracking-tight text-foreground">
                            {route.title}
                          </h1>
                          <StatusBadge tone="info">{environment}</StatusBadge>
                          <StatusBadge>{tenantSlot}</StatusBadge>
                        </div>
                        <p className="max-w-3xl text-sm leading-6 text-muted-foreground">
                          {route.description}
                        </p>
                      </div>
                    </div>
                  </div>
                  <div className="hidden shrink-0 xl:block">
                    <ContextSwitcher />
                  </div>
                </div>
                <div className="flex flex-wrap items-center justify-between gap-3 xl:hidden">
                  <ContextSwitcher />
                </div>
              </div>
            </div>
          </header>
          <main className="flex-1 overflow-y-auto">
            <div className="mx-auto flex w-full max-w-[92rem] flex-col gap-6 px-4 py-6 lg:px-6">
              {children}
            </div>
          </main>
        </div>
      </div>
      <OpsRealtimeRail />
    </div>
  )
}
