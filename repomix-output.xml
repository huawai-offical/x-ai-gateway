<file path="web/src/features/credentials/credentials-page.tsx">
import { type FormEvent, useState } from 'react'
import { useQueryClient } from '@tanstack/react-query'
import { Link } from 'react-router-dom'
import { ArrowUpRightIcon } from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card'
import { Input } from '@/components/ui/input'
import { Textarea } from '@/components/ui/textarea'
import { EmptyState } from '@/components/app/empty-state'
import { InlineError } from '@/components/app/inline-error'
import { PageSection } from '@/components/app/page-section'
import { PageSkeleton } from '@/components/app/page-skeleton'
import { StatusBadge } from '@/components/app/status-badge'
import { formatInstant } from '@/lib/format'
import { apiRequest } from '@/lib/api'
import { useTypedMutation, useTypedQuery } from '@/lib/typed-react-query'
import {
  AUTH_KIND_OPTIONS,
  buildCredentialPayload,
  createEmptyCredentialForm,
  PROVIDER_TYPE_OPTIONS,
  type CredentialConnectivityResponse,
  type CredentialFormState,
  type CredentialModelRefreshResponse,
  type CredentialResponse,
} from './types'
type AccountPool = {
  id: number
  poolName: string
  providerType: string
  active: boolean
}
export function CredentialsPage() {
  const queryClient = useQueryClient()
  const [form, setForm] = useState<CredentialFormState>(createEmptyCredentialForm())
  const [poolName, setPoolName] = useState('')
  const [poolProviderType, setPoolProviderType] = useState('OPENAI_OAUTH')
  const [formError, setFormError] = useState<string | null>(null)
  const [poolError, setPoolError] = useState<string | null>(null)
  const [connectivityResult, setConnectivityResult] = useState<CredentialConnectivityResponse | null>(null)
  const [refreshMessage, setRefreshMessage] = useState<string | null>(null)
  const [poolMessage, setPoolMessage] = useState<string | null>(null)
  const credentialsQuery = useTypedQuery<CredentialResponse[]>({
    queryKey: ['credentials'],
    queryFn: () => apiRequest<CredentialResponse[]>('/admin/credentials'),
  })
  const accountPoolsQuery = useTypedQuery<AccountPool[]>({
    queryKey: ['account-pools'],
    queryFn: () => apiRequest<AccountPool[]>('/admin/account-pools'),
  })
  const createCredentialMutation = useTypedMutation<CredentialResponse, ReturnType<typeof buildCredentialPayload>>({
    mutationFn: (payload) =>
      apiRequest<CredentialResponse>('/admin/credentials', {
        method: 'POST',
        body: JSON.stringify(payload),
      }),
    onSuccess: () => {
      setForm(createEmptyCredentialForm())
      setConnectivityResult(null)
      setRefreshMessage(null)
      setFormError(null)
      queryClient.invalidateQueries({ queryKey: ['credentials'] })
    },
  })
  const createPoolMutation = useTypedMutation<AccountPool, { poolName: string; providerType: string }>({
    mutationFn: (payload) =>
      apiRequest<AccountPool>('/admin/account-pools', {
        method: 'POST',
        body: JSON.stringify({
          poolName: payload.poolName,
          providerType: payload.providerType,
          supportedModels: [],
          supportedProtocols: ['openai'],
          allowedClientFamilies: [],
        }),
      }),
    onSuccess: () => {
      setPoolName('')
      setPoolError(null)
      setPoolMessage('账号池已创建，可以直接发起授权连接。')
      queryClient.invalidateQueries({ queryKey: ['account-pools'] })
    },
  })
  const connectivityMutation = useTypedMutation<CredentialConnectivityResponse, ReturnType<typeof buildCredentialPayload>>({
    mutationFn: (payload) =>
      apiRequest<CredentialConnectivityResponse>('/admin/credentials/test-connectivity', {
        method: 'POST',
        body: JSON.stringify(payload),
      }),
    onSuccess: (data) => {
      setConnectivityResult(data)
      setFormError(null)
    },
  })
  const toggleCredentialMutation = useTypedMutation<CredentialResponse, { id: number; active: boolean }>({
    mutationFn: ({ id, active }) =>
      apiRequest<CredentialResponse>(`/admin/credentials/${id}/status?active=${active}`, {
        method: 'POST',
      }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['credentials'] })
    },
  })
  const refreshCredentialMutation = useTypedMutation<CredentialModelRefreshResponse, number>({
    mutationFn: (credentialId) =>
      apiRequest<CredentialModelRefreshResponse>(`/admin/credentials/${credentialId}/refresh-models`, {
        method: 'POST',
      }),
    onSuccess: (data) => {
      setRefreshMessage(`模型刷新完成：发现 ${data.modelCount} 个模型。`)
      queryClient.invalidateQueries({ queryKey: ['credentials'] })
    },
  })
  const deleteCredentialMutation = useTypedMutation<void, number>({
    mutationFn: (credentialId) =>
      apiRequest<void>(`/admin/credentials/${credentialId}`, {
        method: 'DELETE',
      }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['credentials'] })
    },
  })
  const handleCreateCredential = (event: FormEvent) => {
    event.preventDefault()
    try {
      const payload = buildCredentialPayload(form)
      setFormError(null)
      createCredentialMutation.mutate(payload)
    } catch (error) {
      setFormError(error instanceof Error ? error.message : '无法创建凭证。')
    }
  }
  const handleConnectivityTest = () => {
    try {
      const payload = buildCredentialPayload(form)
      setFormError(null)
      connectivityMutation.mutate(payload)
    } catch (error) {
      setFormError(error instanceof Error ? error.message : '无法测试联通性。')
    }
  }
  const handleCreatePool = (event: FormEvent) => {
    event.preventDefault()
    if (!poolName.trim()) {
      setPoolError('账号池名称不能为空。')
      return
    }
    setPoolError(null)
    createPoolMutation.mutate({
      poolName: poolName.trim(),
      providerType: poolProviderType,
    })
  }
  const handleDeleteCredential = (credential: CredentialResponse) => {
    if (!window.confirm(`确认删除凭证“${credential.credentialName}”吗？`)) {
      return
    }
    deleteCredentialMutation.mutate(credential.id)
  }
  const credentials = credentialsQuery.data ?? []
  const accountPools = accountPoolsQuery.data ?? []
  return (
    <div className="flex flex-col gap-6">
      <PageSection
        kicker="Unified Upstream Entry"
        title="凭证管理"
        description={(
          <>
            这里统一管理 key、OAuth 与 session 型上游接入对象。平台侧策略对象请到{' '}
            <Link className="font-medium text-primary underline-offset-4 hover:underline" to="/keys">
              Keys
            </Link>
            。
          </>
        )}
      >
        <p className="text-sm leading-6 text-muted-foreground">
          所有上游接入对象都在这里收口创建与维护，避免 API key、OAuth 账号池和 session 接入口分散在不同页面。
        </p>
      </PageSection>
      <PageSection
        kicker="API Key / Secret"
        title="凭证录入"
        description="先录入基础连接信息，再补充 proxy、TLS 指纹和 metadata。"
      >
        <form className="flex flex-col gap-4" onSubmit={handleCreateCredential}>
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">凭证名称</span>
              <Input
                value={form.credentialName}
                onChange={(event) => setForm((current) => ({ ...current, credentialName: event.target.value }))}
                placeholder="例如：OpenAI 主账号 Key"
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Provider</span>
              <select
                className="flex h-10 w-full rounded-md border border-input bg-background px-3 text-sm"
                value={form.providerType}
                onChange={(event) => setForm((current) => ({ ...current, providerType: event.target.value }))}
              >
                {PROVIDER_TYPE_OPTIONS.map((option) => (
                  <option key={option} value={option}>{option}</option>
                ))}
              </select>
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Auth Kind</span>
              <select
                className="flex h-10 w-full rounded-md border border-input bg-background px-3 text-sm"
                value={form.authKind}
                onChange={(event) => setForm((current) => ({ ...current, authKind: event.target.value }))}
              >
                {AUTH_KIND_OPTIONS.map((option) => (
                  <option key={option} value={option}>{option}</option>
                ))}
              </select>
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Base URL</span>
              <Input
                value={form.baseUrl}
                onChange={(event) => setForm((current) => ({ ...current, baseUrl: event.target.value }))}
                placeholder="https://api.openai.com"
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Secret / API Key</span>
              <Input
                type="password"
                value={form.secret}
                onChange={(event) => setForm((current) => ({ ...current, secret: event.target.value }))}
                placeholder="输入上游密钥"
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Site Profile ID</span>
              <Input
                value={form.siteProfileId}
                onChange={(event) => setForm((current) => ({ ...current, siteProfileId: event.target.value }))}
                placeholder="可选"
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">Proxy ID</span>
              <Input
                value={form.proxyId}
                onChange={(event) => setForm((current) => ({ ...current, proxyId: event.target.value }))}
                placeholder="可选"
              />
            </label>
            <label className="flex flex-col gap-2">
              <span className="text-sm font-medium text-foreground">TLS 指纹 ID</span>
              <Input
                value={form.tlsFingerprintProfileId}
                onChange={(event) => setForm((current) => ({ ...current, tlsFingerprintProfileId: event.target.value }))}
                placeholder="可选"
              />
            </label>
          </div>
          <label className="flex flex-col gap-2">
            <span className="text-sm font-medium text-foreground">Metadata JSON</span>
            <Textarea
              rows={5}
              value={form.metadataJson}
              onChange={(event) => setForm((current) => ({ ...current, metadataJson: event.target.value }))}
              placeholder='可选，例如 {"organization":"prod"}'
            />
          </label>
          <label className="flex items-center gap-3 rounded-2xl border border-border/60 bg-muted/20 px-4 py-3">
            <input
              type="checkbox"
              className="size-4 rounded border-border"
              checked={form.active}
              onChange={(event) => setForm((current) => ({ ...current, active: event.target.checked }))}
            />
            <span className="text-sm font-medium text-foreground">创建后立即启用</span>
          </label>
          <div className="flex flex-wrap gap-2">
            <Button type="submit" disabled={createCredentialMutation.isPending}>创建凭证</Button>
            <Button type="button" variant="outline" onClick={handleConnectivityTest} disabled={connectivityMutation.isPending}>
              测试联通性
            </Button>
          </div>
        </form>
        {(formError || createCredentialMutation.error || connectivityMutation.error) ? (
          <InlineError
            error={createCredentialMutation.error ?? connectivityMutation.error ?? new Error(formError ?? '凭证操作失败')}
            title="凭证录入失败"
          />
        ) : null}
        {connectivityResult ? (
          <div className="rounded-2xl border border-emerald-200 bg-emerald-50/80 px-4 py-3 text-sm text-emerald-900">
            {connectivityResult.message} 发现 {connectivityResult.discoveredModelCount} 个模型，耗时 {connectivityResult.latencyMs}ms。
          </div>
        ) : null}
        {refreshMessage ? (
          <div className="rounded-2xl border border-cyan-200 bg-cyan-50/80 px-4 py-3 text-sm text-cyan-900">
            {refreshMessage}
          </div>
        ) : null}
      </PageSection>
      <PageSection kicker="Credential Inventory" title="已录入凭证" description="查看当前上游凭证的 provider、状态、指纹和最后使用情况。">
        {credentialsQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : credentialsQuery.error ? (
          <InlineError error={credentialsQuery.error} title="凭证列表加载失败" />
        ) : credentials.length ? (
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {credentials.map((credential) => (
              <Card key={credential.id} className="border-border/60 bg-card/92 shadow-sm">
                <CardHeader className="gap-2 border-b border-border/60">
                  <CardTitle className="text-base">{credential.credentialName}</CardTitle>
                  <CardDescription>{credential.providerType} / {credential.authKind}</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-4 p-5">
                  <div className="flex flex-wrap gap-2">
                    <StatusBadge tone={credential.active ? 'success' : 'warning'}>
                      {credential.active ? 'active' : 'inactive'}
                    </StatusBadge>
                    <StatusBadge>{credential.secretFingerprint}</StatusBadge>
                  </div>
                  <div className="text-sm text-muted-foreground">{credential.baseUrl}</div>
                  <div className="text-sm text-muted-foreground">siteProfileId: {credential.siteProfileId ?? '自动绑定'}</div>
                  <div className="text-sm text-muted-foreground">last used: {formatInstant(credential.lastUsedAt)}</div>
                  {credential.lastErrorMessage ? <div className="text-sm text-rose-700">最近错误：{credential.lastErrorMessage}</div> : null}
                  <div className="flex flex-wrap gap-2">
                    <Button asChild variant="outline" size="sm">
                      <Link to={`/credentials/${credential.id}`}>
                        查看详情
                        <ArrowUpRightIcon data-icon="inline-end" />
                      </Link>
                    </Button>
                    <Button
                      type="button"
                      variant="outline"
                      size="sm"
                      onClick={() => toggleCredentialMutation.mutate({ id: credential.id, active: !credential.active })}
                      disabled={toggleCredentialMutation.isPending}
                    >
                      {credential.active ? '停用' : '启用'}
                    </Button>
                    <Button
                      type="button"
                      variant="outline"
                      size="sm"
                      onClick={() => refreshCredentialMutation.mutate(credential.id)}
                      disabled={refreshCredentialMutation.isPending}
                    >
                      刷新模型
                    </Button>
                    <Button
                      type="button"
                      variant="outline"
                      size="sm"
                      onClick={() => handleDeleteCredential(credential)}
                      disabled={deleteCredentialMutation.isPending}
                    >
                      删除
                    </Button>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : (
          <EmptyState title="还没有上游凭证" description="请先录入厂商 API key / secret，再继续做联通性验证和模型刷新。" />
        )}
      </PageSection>
      <PageSection
        kicker="OAuth / Session"
        title="账号池入口"
        description="OAuth 或 session 型接入仍复用现有 account pool 领域模型，但正式入口统一收口到这里。"
      >
        <form className="grid gap-4 md:grid-cols-[minmax(0,1fr)_18rem_auto]" onSubmit={handleCreatePool}>
          <label className="flex flex-col gap-2">
            <span className="text-sm font-medium text-foreground">账号池名称</span>
            <Input value={poolName} onChange={(event) => setPoolName(event.target.value)} placeholder="账号池名称" />
          </label>
          <label className="flex flex-col gap-2">
            <span className="text-sm font-medium text-foreground">Provider Type</span>
            <select
              className="flex h-10 w-full rounded-md border border-input bg-background px-3 text-sm"
              value={poolProviderType}
              onChange={(event) => setPoolProviderType(event.target.value)}
            >
              <option value="OPENAI_OAUTH">OPENAI_OAUTH</option>
              <option value="GEMINI_OAUTH">GEMINI_OAUTH</option>
              <option value="CLAUDE_ACCOUNT">CLAUDE_ACCOUNT</option>
            </select>
          </label>
          <div className="flex items-end">
            <Button type="submit" disabled={createPoolMutation.isPending}>创建账号池</Button>
          </div>
        </form>
        {(poolError || createPoolMutation.error) ? (
          <InlineError error={createPoolMutation.error ?? new Error(poolError ?? '账号池创建失败')} title="账号池创建失败" />
        ) : null}
        {poolMessage ? (
          <div className="rounded-2xl border border-cyan-200 bg-cyan-50/80 px-4 py-3 text-sm text-cyan-900">
            {poolMessage}
          </div>
        ) : null}
        {accountPoolsQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : accountPoolsQuery.error ? (
          <InlineError error={accountPoolsQuery.error} title="账号池列表加载失败" />
        ) : accountPools.length ? (
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {accountPools.map((pool) => (
              <Card key={pool.id} className="border-border/60 bg-card/92 shadow-sm">
                <CardHeader className="gap-2 border-b border-border/60">
                  <CardTitle className="text-base">{pool.poolName}</CardTitle>
                  <CardDescription>{pool.providerType}</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-4 p-5">
                  <StatusBadge tone={pool.active ? 'success' : 'warning'}>
                    {pool.active ? 'active' : 'inactive'}
                  </StatusBadge>
                  <div className="text-sm text-muted-foreground">OAuth / session 型接入入口</div>
                  <div className="flex flex-wrap gap-2">
                    <Button asChild variant="outline" size="sm">
                      <Link to={`/account-pools/${pool.id}`}>
                        查看详情
                        <ArrowUpRightIcon data-icon="inline-end" />
                      </Link>
                    </Button>
                    <Button asChild variant="outline" size="sm">
                      <Link to={`/accounts/connect/${pool.providerType.toLowerCase()}?poolId=${pool.id}`}>
                        发起授权
                        <ArrowUpRightIcon data-icon="inline-end" />
                      </Link>
                    </Button>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : (
          <EmptyState title="还没有 OAuth / session 型账号池" description="创建账号池后，即可继续发起授权连接。" />
        )}
      </PageSection>
    </div>
  )
}
