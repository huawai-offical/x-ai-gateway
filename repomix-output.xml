        method: 'POST',
        body: JSON.stringify({
          distributedKeyId: Number(distributedKeyId),
          providerType: poolQuery.data?.providerType === 'OPENAI_OAUTH'
            ? 'OPENAI_DIRECT'
            : poolQuery.data?.providerType === 'GEMINI_OAUTH'
              ? 'GEMINI_DIRECT'
              : 'ANTHROPIC_DIRECT',
        }),
      }),
    onSuccess: () => setDistributedKeyId(''),
  })
  const handleBind = (event: FormEvent) => {
    event.preventDefault()
    if (!distributedKeyId.trim()) return
    bindMutation.mutate()
  }
  const pool = poolQuery.data
  const poolItems = useMemo(
    () =>
      pool
        ? [
            { key: 'provider', label: 'Provider Type', value: pool.providerType },
            { key: 'pool-id', label: 'Pool ID', value: pool.id },
          ]
        : [],
    [pool],
  )
  return (
    <div className="flex flex-col gap-6">
      <PageSection
        kicker="Pool Detail"
        title={pool?.poolName ?? '账号池'}
        description="这里承载 OAuth 或 session 型账号池的授权入口、绑定信息和池内账号清单。"
        actions={
          pool ? (
            <Button asChild>
              <Link to={`/accounts/connect/${pool.providerType.toLowerCase()}?poolId=${pool.id}`}>
                发起 OAuth 连接
                <ArrowUpRightIcon data-icon="inline-end" />
              </Link>
            </Button>
          ) : null
        }
      >
        {poolQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : poolQuery.error ? (
          <InlineError error={poolQuery.error} title="账号池详情加载失败" />
        ) : pool ? (
          <div className="flex flex-col gap-6">
            <InfoGrid items={poolItems} columnsClassName="md:grid-cols-2" />
            {bindMutation.error ? <InlineError error={bindMutation.error} title="绑定 DistributedKey 失败" /> : null}
            <form className="flex flex-col gap-4 rounded-2xl border border-border/60 bg-muted/20 p-4 md:flex-row md:items-end" onSubmit={handleBind}>
              <label className="flex min-w-0 flex-1 flex-col gap-2">
                <span className="text-sm font-medium text-foreground">DistributedKey ID</span>
                <Input
                  value={distributedKeyId}
                  onChange={(event) => setDistributedKeyId(event.target.value)}
                  placeholder="绑定 DistributedKey ID"
                />
              </label>
              <Button type="submit" disabled={bindMutation.isPending || !distributedKeyId.trim()}>
                绑定到 Key
              </Button>
            </form>
          </div>
        ) : (
          <EmptyState title="未找到账号池" description="请确认当前账号池仍然存在，或返回凭证页重新创建接入入口。" />
        )}
      </PageSection>
      <PageSection
        kicker="Pool Accounts"
        title="池内账号"
        description="查看当前账号池下可参与路由的账号及其健康状态。"
      >
        {accountsQuery.isPending ? (
          <PageSkeleton count={1} />
        ) : accountsQuery.error ? (
          <InlineError error={accountsQuery.error} title="账号列表加载失败" />
        ) : accountsQuery.data?.length ? (
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {accountsQuery.data.map((account: Account) => (
              <Card key={account.id} className="border-border/60 bg-card/92 shadow-sm">
                <CardHeader className="gap-2 border-b border-border/60">
                  <CardTitle className="text-base">{account.accountName}</CardTitle>
                  <CardDescription>查看账号健康、冻结状态和导出配置。</CardDescription>
                </CardHeader>
                <CardContent className="flex flex-col gap-4 p-5">
                  <div className="flex flex-wrap gap-2">
                    <StatusBadge tone={account.healthy ? 'success' : 'danger'}>
                      {account.healthy ? 'healthy' : 'unhealthy'}
                    </StatusBadge>
                    <StatusBadge tone={account.frozen ? 'warning' : 'info'}>
                      {account.frozen ? 'frozen' : 'active'}
                    </StatusBadge>
                  </div>
                  <Button asChild variant="outline" size="sm">
                    <Link to={`/accounts/${account.id}`}>
                      查看账号
                      <ArrowUpRightIcon data-icon="inline-end" />
                    </Link>
                  </Button>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : (
          <EmptyState title="当前账号池还没有账号" description="可以先发起 OAuth 连接，完成授权后再回来查看这里的账号状态。" />
        )}
      </PageSection>
    </div>
  )
}
