import { useState } from 'react'
import { Link, useParams, useSearchParams } from 'react-router-dom'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card'
import { EmptyState } from '@/components/app/empty-state'
import { InfoGrid } from '@/components/app/info-grid'
import { InlineError } from '@/components/app/inline-error'
import { PageSection } from '@/components/app/page-section'
import { PageSkeleton } from '@/components/app/page-skeleton'
import { StatusBadge } from '@/components/app/status-badge'
import { formatInstant } from '@/lib/format'
import { apiRequest } from '@/lib/api'
import { useTypedQuery } from '@/lib/typed-react-query'
import {
  type ProviderSiteDossierResponse,
  type SiteModelCapability,
  type SurfaceDossierItemResponse,
} from './types'
const DOSSIER_TABS = ['summary', 'surfaces', 'models', 'trace-links'] as const
type DossierTab = (typeof DOSSIER_TABS)[number]
export function ProviderSiteDetailPage() {
  const params = useParams()
  const [searchParams] = useSearchParams()
  const [activeTab, setActiveTab] = useState<DossierTab>('summary')
  const id = Number(params.id)
  const selectedSurface = searchParams.get('surface')
  const dossierQuery = useTypedQuery<ProviderSiteDossierResponse>({
    queryKey: ['provider-site-dossier', id],
    queryFn: () => apiRequest<ProviderSiteDossierResponse>(`/admin/provider-sites/${id}/dossier`),
    enabled: Number.isFinite(id),
  })
  const dossier = dossierQuery.data
  const site = dossier?.site
  const filteredCapabilities = (dossier?.capabilities ?? []).filter((item) => matchesSurface(item, selectedSurface))
  if (dossierQuery.isPending) {
    return <PageSkeleton count={1} />
  }
  if (dossierQuery.error) {
    return <InlineError error={dossierQuery.error} title="站点运行档案加载失败" />
  }
  if (!site || !dossier) {
    return <EmptyState title="未找到站点运行档案" description="请返回站点列表重新选择，或确认当前站点是否已被删除。" />
  }
  return (
    <div className="flex flex-col gap-6">
      <PageSection
        kicker="Site Dossier"
        title={site.displayName}
        description="详情页先给运行结论、blocker 和建议动作，编辑行为拆到独立 settings 页面。"
        actions={
          <div className="flex flex-wrap gap-2">
            <Button asChild variant="outline" size="sm">
              <Link to="/provider-sites">返回站点列表</Link>
            </Button>
            <Button asChild variant="outline" size="sm">
              <Link to={`/provider-sites/${site.id}/settings`}>编辑站点设置</Link>
            </Button>
            <Button asChild size="sm">
              <Link
                to={`/workbench?protocol=openai&requestPath=${encodeURIComponent(selectedSurfacePath(dossier, selectedSurface) ?? '/v1/chat/completions')}&requestedModel=${encodeURIComponent(filteredCapabilities[0]?.modelKey ?? '')}`}
              >
                打开 Workbench
              </Link>
            </Button>
          </div>
        }
      >
        <div className="flex flex-col gap-4">
          <div className="flex flex-wrap gap-2">
            {DOSSIER_TABS.map((tab) => (
              <Button
                key={tab}
                type="button"
                variant={activeTab === tab ? 'default' : 'outline'}
                size="sm"
                onClick={() => setActiveTab(tab)}
              >
                {tabLabel(tab)}
              </Button>
            ))}
          </div>
          <InfoGrid
            items={[
              { key: 'provider', label: 'Provider', value: `${site.providerFamily} / ${site.siteKind}` },
              {
                key: 'health',
                label: 'Health',
                value: <StatusBadge tone={site.healthState === 'READY' ? 'success' : site.healthState === 'BLOCKED' ? 'danger' : 'warning'}>{site.healthState}</StatusBadge>,
              },
              { key: 'surface', label: 'compatibilitySurface', value: site.compatibilitySurface },
              { key: 'cooldown', label: 'Cooldown', value: `${site.cooldownCredentialCount} / ${formatInstant(site.cooldownUntil)}` },
            ]}
            columnsClassName="md:grid-cols-2 xl:grid-cols-4"
          />
          {site.blockedReason ? (
            <div className="rounded-2xl border border-rose-200 bg-rose-50/80 px-4 py-3 text-sm text-rose-900">
              site blocker: {site.blockedReason}
            </div>
          ) : null}
        </div>
      </PageSection>
      {activeTab === 'summary' ? (
        <PageSection kicker="Summary" title="运行摘要" description="先看当前运行状态，再看推荐动作和全局 blocker / degradation 数量。">
          <div className="flex flex-col gap-6">
            {dossier.recommendedActions.length ? (
              <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {dossier.recommendedActions.map((action) => (
                  <Card key={action} className="border-border/60 bg-card/92 shadow-sm">
                    <CardHeader className="gap-2 border-b border-border/60">
                      <CardTitle className="text-base">Recommended action</CardTitle>
                    </CardHeader>
                    <CardContent className="p-5 text-sm text-foreground">{action}</CardContent>
                  </Card>
                ))}
              </div>
            ) : null}
            <InfoGrid
              items={[
                { key: 'blocked', label: 'Blocked surfaces', value: dossier.blockedSurfaces.length },
                { key: 'degraded', label: 'Degraded surfaces', value: dossier.degradedSurfaces.length },
                { key: 'accepted', label: 'Accepted exceptions', value: dossier.acceptedExceptions.length },
                { key: 'models', label: 'Models', value: dossier.capabilities.length },
              ]}
              columnsClassName="md:grid-cols-2 xl:grid-cols-4"
            />
          </div>
        </PageSection>
      ) : null}
      {activeTab === 'surfaces' ? (
        <PageSection kicker="Surfaces" title="Surface 限制与能力" description="按 blocked、degraded 和 accepted exception 三类组织能力面。">
          <div className="grid gap-4 xl:grid-cols-3">
            <SurfaceSection title="Blocked" items={dossier.blockedSurfaces} siteId={site.id} />
            <SurfaceSection title="Degraded" items={dossier.degradedSurfaces} siteId={site.id} />
            <SurfaceSection title="Accepted exceptions" items={dossier.acceptedExceptions} siteId={site.id} />
          </div>
        </PageSection>
      ) : null}
      {activeTab === 'models' ? (
        <PageSection kicker="Models" title="模型档案" description="查看当前筛选 surface 下，模型支持级别和可用 backend。">
          {filteredCapabilities.length ? (
            <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {filteredCapabilities.map((item) => (
                <Card key={item.id} className="border-border/60 bg-card/92 shadow-sm">
                  <CardHeader className="gap-2 border-b border-border/60">
                    <CardTitle className="text-base">{item.modelName}</CardTitle>
                    <CardDescription>{item.modelKey}</CardDescription>
                  </CardHeader>
                  <CardContent className="flex flex-col gap-3 p-5 text-sm text-muted-foreground">
                    <StatusBadge tone={item.capabilityLevel === 'NATIVE' ? 'success' : 'warning'}>
                      {item.capabilityLevel}
                    </StatusBadge>
                    <div className="text-foreground">
                      backend: {item.preferredBackend ?? '-'} / {(item.supportedBackends ?? []).join(', ') || '无'}
                    </div>
                  </CardContent>
                </Card>
              ))}
            </div>
          ) : (
            <EmptyState title="当前筛选下没有模型记录" description="可以切换 surface 或回到 Summary 查看推荐动作与 blocker。" />
          )}
        </PageSection>
      ) : null}
      {activeTab === 'trace-links' ? (
        <PageSection kicker="Trace Links" title="下一步入口" description="从全局矩阵、Trace 和 Incident 继续向下联查。">
          <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <LinkCard
              title="Capability matrix"
              description="从全局 blocker / degraded / accepted exception 视角继续定位。"
              to="/capability-matrix"
              label="打开矩阵"
            />
            <LinkCard
              title="Trace workbench"
              description="按 providerType/requestPath 查看最近请求的 route、cache 和 async 资源线索。"
              to={`/traces?providerType=${encodeURIComponent(site.siteKind)}&requestPath=${encodeURIComponent(selectedSurfacePath(dossier, selectedSurface) ?? '/v1/chat/completions')}`}
              label="打开 Traces"
            />
            <LinkCard
              title="Incident command center"
              description="从事件维度看受影响实体与建议动作。"
              to={`/incidents?entityType=SITE_PROFILE&entityRef=${encodeURIComponent(String(site.id))}`}
              label="打开 Incidents"
            />
          </div>
        </PageSection>
      ) : null}
    </div>
  )
}
function SurfaceSection({ title, items, siteId }: { title: string; items: SurfaceDossierItemResponse[]; siteId?: number }) {
  return (
    <Card className="border-border/60 bg-card/92 shadow-sm">
      <CardHeader className="gap-2 border-b border-border/60">
        <CardTitle className="text-base">{title}</CardTitle>
        <CardDescription>{items.length ? `${items.length} 条记录` : '当前没有记录'}</CardDescription>
      </CardHeader>
      <CardContent className="flex flex-col gap-4 p-5">
        {items.length ? (
          items.map((item) => (
            <div key={`${title}-${item.surfaceKey}`} className="flex flex-col gap-3 rounded-2xl border border-border/60 bg-muted/20 p-4">
              <div className="flex flex-wrap gap-2">
                <StatusBadge tone={title === 'Blocked' ? 'danger' : title === 'Degraded' ? 'warning' : 'info'}>
                  {item.operation}
                </StatusBadge>
                <StatusBadge>{item.supportStatus ?? '-'}</StatusBadge>
                <StatusBadge>{item.degradationLevel ?? '-'}</StatusBadge>
              </div>
              <div className="text-sm text-foreground">{item.normalizedPath ?? '无 normalizedPath'}</div>
              {item.blockerReasons.length ? <div className="text-sm text-rose-700">{item.blockerReasons.join('；')}</div> : null}
              {item.lossReasons.length ? <div className="text-sm text-amber-700">{item.lossReasons.join('；')}</div> : null}
              {siteId ? (
                <div className="flex flex-wrap gap-2">
                  <Button asChild variant="outline" size="sm">
                    <Link to={`/provider-sites/${siteId}/settings`}>设置</Link>
                  </Button>
                  <Button asChild variant="outline" size="sm">
                    <Link to={`/workbench?protocol=openai&requestPath=${encodeURIComponent(item.normalizedPath ?? '/v1/chat/completions')}`}>Workbench</Link>
                  </Button>
                </div>
              ) : null}
            </div>
          ))
        ) : (
          <EmptyState title="当前没有记录" />
        )}
      </CardContent>
    </Card>
  )
}
function LinkCard({ title, description, to, label }: { title: string; description: string; to: string; label: string }) {
  return (
    <Card className="border-border/60 bg-card/92 shadow-sm">
      <CardHeader className="gap-2 border-b border-border/60">
        <CardTitle className="text-base">{title}</CardTitle>
        <CardDescription>{description}</CardDescription>
      </CardHeader>
      <CardContent className="p-5">
        <Button asChild variant="outline" size="sm">
          <Link to={to}>{label}</Link>
        </Button>
      </CardContent>
    </Card>
  )
}
function matchesSurface(model: SiteModelCapability, surface?: string | null) {
  if (!surface) return true
  return Boolean(model.surfaces[surface])
}
function selectedSurfacePath(dossier?: ProviderSiteDossierResponse, surfaceKey?: string | null) {
  if (!surfaceKey || !dossier) return null
  const surface =
    dossier.blockedSurfaces.find((item) => item.surfaceKey === surfaceKey)
    ?? dossier.degradedSurfaces.find((item) => item.surfaceKey === surfaceKey)
    ?? dossier.acceptedExceptions.find((item) => item.surfaceKey === surfaceKey)
    ?? dossier.capabilities.find((item) => item.surfaces[surfaceKey])?.surfaces[surfaceKey]
  return surface?.normalizedPath ?? null
}
function tabLabel(tab: DossierTab) {
  switch (tab) {
    case 'summary':
      return 'Summary'
    case 'surfaces':
      return 'Surfaces'
    case 'models':
      return 'Models'
    case 'trace-links':
      return 'Trace links'
  }
}
