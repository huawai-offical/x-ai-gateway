    }
    private UpstreamTarget resolveAnthropicMessageBatchTargetForEntity(
            GatewayAsyncResourceEntity entity,
            ObjectNode metadata) {
        Long credentialId = metadata.has("credential_id") ? metadata.path("credential_id").asLong() : null;
